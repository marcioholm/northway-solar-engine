{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/schedule$": "<rootDir>/stubs/schedule.stub.ts",
    "^puppeteer$": "<rootDir>/stubs/puppeteer.stub.ts",
    "^puppeteer-core$": "<rootDir>/stubs/puppeteer.stub.ts"
  }
}
