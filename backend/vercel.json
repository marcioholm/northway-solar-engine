{
    "buildCommand": "npx nest build",
    "outputDirectory": ".",
    "regions": ["gru1"],
    "functions": {
        "api/index.js": {
            "memory": 512,
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.js" }
    ]
}
