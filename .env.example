# App
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (Supabase PostgreSQL)
# Aplique o esquema com: cd backend && npm run db:migrate
DATABASE_URL=postgres://postgres.project_ref:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

DB_SSL=true
# Nunca use true em banco com dados.
DB_SYNCHRONIZE=false

# Supabase (somente backend)
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
